# Server-side administrator login. Generate values with:
# node scripts/create-vercel-admin-secrets.mjs
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ADMIN_TOTP_SECRET=replace-with-base32-totp-secret
ADMIN_SESSION_SECRET=replace-with-at-least-64-hex-characters
ADMIN_RECOVERY_CODE_HASHES=[]

# Private Vercel Blob store for drafts and contact messages.
CONTENT_BLOB_READ_WRITE_TOKEN=
# Public Vercel Blob store for blog images.
MEDIA_BLOB_READ_WRITE_TOKEN=

# Public URLs and branding
NEXT_PUBLIC_SITE_NAME=HazelSite HQ
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_BLOG_URL=http://localhost:3000
