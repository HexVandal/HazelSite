# Optional Vercel Blob connection. The same private content store token must be
# configured in the HQ Vercel project so published posts and messages persist.
CONTENT_BLOB_READ_WRITE_TOKEN=

# Vercel Analytics is automatically enabled when the @vercel/analytics component
# is present in the production deployment.

# Optional public site URL (used for canonical metadata)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
HQ_URL=https://your-hq.vercel.app
