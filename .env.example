# Reference only. For local dev, copy the app-specific template to that app's
# ignored .env.local: apps/site/.env.example or apps/hq/.env.example.
# For Vercel, configure each variable in the relevant project's Environment
# Variables. Keep all Blob tokens and admin secrets server-side.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
HQ_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_BLOG_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=HazelSite HQ
CONTENT_BLOB_READ_WRITE_TOKEN=
MEDIA_BLOB_READ_WRITE_TOKEN=
