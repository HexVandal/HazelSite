# Local monorepo configuration template; copy to .env and replace secrets.
POSTGRES_USER=hazel
POSTGRES_PASSWORD=replace-this-for-local-and-deployment
POSTGRES_DB=hazel

# API service: generate a 32-byte hex secret, for example: openssl rand -hex 32
PASETO_SYMMETRIC_KEY=replace-with-64-hex-characters
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SUPERADMIN_EMAILS=you@example.com
FRONTEND_URL=http://localhost:3000

# HQ talks to the Go API over gRPC on the Compose network.
# Generate a Gloom API token after the API/database are running; see services/api/cmd/token.
API_TOKEN=
HQ_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HazelSite's existing API/session configuration while its routes are being migrated.
DATABASE_URL=postgresql://hazel:replace-this-for-local-and-deployment@localhost:5432/hazel
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SETUP_TOKEN=replace-with-a-long-one-time-bootstrap-secret
GLOOM_API_INTERNAL_URL=http://127.0.0.1:8080

# Optional Realm API integrations (leave blank if unused)
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
LASTFM_API_KEY=
LASTFM_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
CONTACT_RECEIVER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional S3-compatible settings when STORAGE_BACKEND=s3
S3_BUCKET=hazelsite-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_USE_PATH_STYLE=true
S3_PUBLIC_DOMAIN=
